  mdIn.value=''; mdOut.innerHTML='';
  mdInCol.classList.remove('has-in'); mdOutCol.classList.remove('has-out');
  mdStats.textContent=''; localStorage.removeItem('pt-draft-md'); mdIn.focus();
});
document.getElementById('md-copy').addEventListener('click', function(){ copyText(mdOut.innerText, this); });
setupDrop(document.getElementById('md-dual'), document.getElementById('md-drop'), mdIn);

