/* ══════════════════════════════════════
   MARKDOWN → Rendered
   ══════════════════════════════════════ */
const mdIn = document.getElementById('md-in');
const mdOut = document.getElementById('md-out');
const mdInCol = document.getElementById('md-in-col');
const mdOutCol = document.getElementById('md-out-col');
const mdStats = document.getElementById('md-stats');

function renderMarkdown(src) {
  if (!src.trim()) return '';
  const codeBlocks = [];
  let s = src.replace(/```[\s\S]*?```/g, m => { codeBlocks.push(m); return `\x01C${codeBlocks.length-1}\x01`; });
  s = s.replace(/`[^`\n]+`/g, m => { codeBlocks.push(m); return `\x01C${codeBlocks.length-1}\x01`; });
  const mathSlots = [];
  s = s.replace(/\$\$([\s\S]*?)\$\$/g, (_,tex) => { mathSlots.push({display:true,tex}); return `\x00M${mathSlots.length-1}\x00`; });
  s = s.replace(/\\\[([\s\S]*?)\\\]/g, (_,tex) => { mathSlots.push({display:true,tex}); return `\x00M${mathSlots.length-1}\x00`; });
  s = s.replace(/(?<!\$)\$(?!\$)([^\n]*?[^\$])\$/g, (_,tex) => { mathSlots.push({display:false,tex}); return `\x00M${mathSlots.length-1}\x00`; });
  s = s.replace(/\\\((.*?)\\\)/g, (_,tex) => { mathSlots.push({display:false,tex}); return `\x00M${mathSlots.length-1}\x00`; });
  s = s.replace(/\x01C(\d+)\x01/g, (_,i) => codeBlocks[parseInt(i)]);
  let html = marked.parse(s);
  html = html.replace(/\x00M(\d+)\x00/g, (_,i) => {
    const m = mathSlots[parseInt(i)];
    try { return katex.renderToString(m.tex.trim(),{displayMode:m.display,throwOnError:false}); }
    catch { return `<code>${m.tex}</code>`; }
  });
  return html;
}

const syncMd = debounce(() => {
  mdOut.innerHTML = renderMarkdown(mdIn.value);
  mdInCol.classList.toggle('has-in', mdIn.value.trim().length>0);
  mdOutCol.classList.toggle('has-out', mdOut.innerHTML.length>0);
  mdStats.textContent = countStats(mdIn.value);
  autoSave('md', mdIn.value);
}, 150);
mdIn.addEventListener('input', syncMd);
